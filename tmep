def find_common(arr):
    full = ''
    for i in range(11):
        if i >= len(arr[0]): 
            cur = 'X'
        else:
            cur = arr[0][i]
        for k in arr:
            if i >= len(k) or k[i] != cur:
                cur = 'X'
                break
        full += cur
    return full
