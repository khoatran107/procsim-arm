<?xml version="1.0" encoding="UTF-8"?>
<Simulator>
	<simname>LEGv8 Single-Cycle - R-Format, LDUR, STUR, CBZ, B</simname>
	<SuportedISA>R-Format, LDUR, STUR, CBZ, B</SuportedISA>
	<Options resetEveryRound="true"/>

	<Component>
		<name>PC</name>
		<description>Progam Counter</description>
		<specialComponent comp="StartComp"/>
		<hidden>false</hidden>
		<outputBuses>
			<output name="PC" bits="64" alternativeStr="true">
				<to name="PCAddress" comp="InstrMemory"/>
				<to name="PC" comp="MuxALU1SRC"/>
				<to name="PC" comp="MuxPCTOREG2"/>
				<to name="PC" comp="PCIncrement"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="newPC" bits="64"/>
		</inputBuses>
		<operations>
			<op name="ReadReg1">
				<dependsOn which="always" if="always"/>
				<do func="mux">
					<inputs>
						<in name="newPC"/>
					</inputs>
					<outputs>
						<out name="PC"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>InstrMemory</name>
		<specialComponent comp="InstructionMemory"/>
		<description>Intruction Memory</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Intruction" bits="32" alternativeStr="true">
				<to name="Instr" comp="Spliter"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="PCAddress" bits="64"/>
		</inputBuses>
		<operations>
			<op name="ReadAddress">
				<dependsOn which="always" if="always"/>
				<do func="getInstruction">
					<inputs>
						<in name="PCAddress"/>
					</inputs>
					<outputs>
						<out name="Intruction"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>


	<Component>
		<name>Spliter</name>
		<description>Instruction Spliter</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Opcode" bits="11">
				<to name="Opcode" comp="Control"/>
				<to name="Opcode" comp="BranchControl"/>
			</output>
			<output name="FullInstruction" bits="32">
				<to name="FullInstruction" comp="SignExtend"/>
			</output>
			<output name="Rm" bits="5">
				<to name="Rm" comp="MuxREG2LOC"/>
			</output>
			<output name="Rd" bits="5">
				<to name="Rd" comp="BranchControl"/>
				<to name="Rd" comp="MuxREG2LOC"/>
				<to name="Rd" comp="MuxPCTOREG1"/>
			</output>
			<output name="Rn" bits="5">
				<to name="Rn" comp="MuxREG1LOC"/>
			</output>
			<output name="Shamt" bits="6">
				<to name="Shamt" comp="ALU"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="Instr" bits="32"/>
		</inputBuses>
		<operations>
			<op name="Opcode31-21">
				<dependsOn which="always" if="always"/>
				<do func="split" out="31-21">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Opcode"/>
					</outputs>
				</do>
			</op>
			<op name="FullInstruction31-0">
				<dependsOn which="always" if="always"/>
				<do func="split" out="31-0">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="FullInstruction"/>
					</outputs>
				</do>
			</op>
			<op name="Rm20-16">
				<dependsOn which="always" if="always"/>
				<do func="split" out="20-16">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Rm"/>
					</outputs>
				</do>
			</op>
			<op name="Rn9-5">
				<dependsOn which="always" if="always"/>
				<do func="split" out="9-5">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Rn"/>
					</outputs>
				</do>
			</op>
			<op name="Rd4-0">
				<dependsOn which="always" if="always"/>
				<do func="split" out="4-0">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Rd"/>
					</outputs>
				</do>
			</op>
			<op name="Shamt5-0">
				<dependsOn which="always" if="always"/>
				<do func="split" out="5-0">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Shamt"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	

	<Component>
		<name>Control</name>
		<description>Control Unit</description>
		<hidden>false</hidden>
		<inputBuses>
			<input name="Opcode" bits="11"/>
		</inputBuses>
		<outputBuses>
			<output name="ALUOP" bits="6">
				<to name="ALUOP" comp="ALU"/>
			</output>
			<output name="MOVOP" bits="3">
				<to name="MOVOP" comp="MOV"/>
			</output>
			<output name="MEMSIZE" bits="2">
				<to name="MEMSIZE" comp="Memory"/>
			</output>
			<output name="SIGNLOAD" bits="1">
				<to name="SIGNLOAD" comp="Memory"/>
			</output>
			<output name="REG1LOC" bits="1">
				<to name="REG1LOC" comp="MuxREG1LOC"/>
			</output>
			<output name="REG2LOC" bits="1">
				<to name="REG2LOC" comp="MuxREG2LOC"/>
			</output>
			<output name="USEMOV" bits="1">
				<to name="USEMOV" comp="MuxUSEMOV"/>
			</output>
			<output name="ALU1SRC" bits="1">
				<to name="ALU1SRC" comp="MuxALU1SRC"/>
			</output>
			<output name="ALU2SRC" bits="1">
				<to name="ALU2SRC" comp="MuxALU2SRC"/>
			</output>
			<output name="SETFLAGS" bits="1">
				<to name="SETFLAGS" comp="FlagControl"/>
			</output>
			<output name="MEMREAD" bits="1">
				<to name="MEMREAD" comp="Memory"/>
			</output>
			<output name="MEMWRITE" bits="1">
				<to name="MEMWRITE" comp="Memory"/>
			</output>
			<output name="MEMTOREG" bits="1">
				<to name="MEMTOREG" comp="MuxMEMTOREG"/>
			</output>
			<output name="PCTOREG" bits="1">
				<to name="PCTOREG" comp="MuxPCTOREG1"/>
				<to name="PCTOREG" comp="MuxPCTOREG2"/>
			</output>
			<output name="REGWRITE" bits="1">
				<to name="REGWRITE" comp="Registers"/>
			</output>
		</outputBuses>
		<operations>
			<op name="control">
				<do func="control">
					<inputs>
						<in name="Opcode"/>
					</inputs>
					<outputs>
						<out name="ALUOP"/>
						<out name="MOVOP"/>
						<out name="MEMSIZE"/>

						<out name="SIGNLOAD"/>
						<out name="REG1LOC"/>
						<out name="REG2LOC"/>
						<out name="USEMOV"/>
						<out name="ALU1SRC"/>
						<out name="ALU2SRC"/>
						<out name="SETFLAGS"/>
						<out name="MEMREAD"/>
						<out name="MEMWRITE"/>
						<out name="REGWRITE"/>
						<out name="PCTOREG"/>
						<out name="MEMTOREG"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	
	<Component>
		<name>Registers</name>
		<specialComponent comp="Registers"/>
		<description>Set of Registers</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ReadData1" bits="64" alternativeStr="true">
				<to name="ReadData1" comp="MuxALU1SRC"/>
			</output>
			<output name="ReadData2" bits="64" alternativeStr="true">
				<to name="ReadData2" comp="BranchControl"/>
				<to name="ReadData2" comp="MuxALU2SRC"/>
				<to name="ReadData2" comp="MOV"/>
				<to name="WriteData" comp="Memory"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="ReadReg1" bits="5"/>
			<input name="ReadReg2" bits="5"/>
			<input name="WriteReg" bits="5"/>
			<input name="WriteData" bits="64"/>
			<input name="REGWRITE" bits="1"/>
		</inputBuses>
		<operations>
			<op name="ReadReg1">
				<dependsOn which="always" if="always"/>
				<do func="readreg">
					<inputs>
						<in name="ReadReg1"/>
					</inputs>
					<outputs>
						<out name="ReadData1"/>
					</outputs>
				</do>
			</op>
			<op name="ReadReg2">
				<dependsOn which="always" if="always"/>
				<do func="readreg">
					<inputs>
						<in name="ReadReg2"/>
					</inputs>
					<outputs>
						<out name="ReadData2"/>
					</outputs>
				</do>
			</op>
			<op name="WriteData">
				<dependsOn which="REGWRITE" if="1"/>
				<do func="writereg">
					<inputs>
						<in name="WriteReg"/>
						<in name="WriteData"/>
					</inputs>
					<outputs>
						<out name="ReadData2"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>SignExtend</name>
		<description>Sign Extend base on instruction</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="SignExtended" bits="64" alternativeStr="true">
				<to name="SignExtended" comp="MuxALU2SRC"/>
				<to name="Extended" comp="MOV"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="FullInstruction" bits="32"/>
		</inputBuses>
		<operations>
			<op name="SignExtend">
				<dependsOn which="always" if="always"/>
				<do func="signExtend">
					<inputs>
						<in name="FullInstruction"/>
					</inputs>
					<outputs>
						<out name="SignExtended"/>
					</outputs>
				</do>
			</op>

		</operations>
	</Component>

	<Component>
		<name>FlagControl</name>
		<description>Flag Control Unit</description>
		<hidden>false</hidden>
		<inputBuses>
			<input name="SETFLAGS" bits="1"/>
			<input name="NewFlags" bits="4"/>
		</inputBuses>
		<outputBuses>
			<output name="Flags" bits="4">
				<to name="Flags" comp="BranchControl"/>
			</output>
		</outputBuses>
		<operations>
			<op name="FlagControl">
				<dependsOn which="always" if="always"/>
				<do func="flagControl">
					<inputs>
						<in name="SETFLAGS"/>
						<in name="NewFlags"/>
					</inputs>
					<outputs>
						<out name="Flags"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	
	<Component>
		<name>BranchControl</name>
		<description>Branch Control Unit</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Branch" bits="1">
				<to name="Branch" comp="MuxBranch"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="Opcode" bits="11"/>
			<input name="ReadData2" bits="64"/>
			<input name="Rd" bits="5"/>
			<input name="Flags" bits="4"/>
		</inputBuses>
		<operations>
			<op name="BranchControl">
				<dependsOn which="always" if="always"/>
				<do func="branchControl">
					<inputs>
						<in name="Opcode"/>
						<in name="ReadData2"/>
						<in name="Rd"/>
						<in name="Flags"/>
					</inputs>
					<outputs>
						<out name="Branch"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>ALU</name>
		<description>Arithmetic Logic Unit</description>
		<hidden>false</hidden>
		<inputBuses>
			<input name="ALUOP" bits="6"/>
			<input name="ALUInp1" bits="64"/>
			<input name="ALUInp2" bits="64"/>
			<input name="Shamt" bits="6"/>
		</inputBuses>
		<outputBuses>
			<output name="ALUResult" bits="64" alternativeStr="true">
				<to name="ALUResult" comp="MuxUSEMOV"/>
			</output>
			<output name="Flags" bits="4">
				<to name="NewFlags" comp="FlagControl"/>
			</output>
		</outputBuses>
		<operations>
			<op name="ALU">
				<dependsOn which="always" if="always"/>
				<do func="alu">
					<inputs>
						<in name="ALUInp1"/>
						<in name="ALUInp2"/>
						<in name="Shamt"/>
						<in name="ALUOP"/>
					</inputs>
					<outputs>
						<out name="ALUResult"/>
						<out name="Flags"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>MOV</name>
		<description>MOV</description>
		<hidden>false</hidden>
		<inputBuses>
			<input name="ReadData2" bits="64"/>
			<input name="Extended" bits="64"/>
			<input name="MOVOP" bits="3"/>
		</inputBuses>
		<outputBuses>
			<output name="MOVResult" bits="64" alternativeStr="true">
				<to name="MOVResult" comp="MuxUSEMOV"/>
			</output>
		</outputBuses>
		<operations>
			<op name="MOV">
				<dependsOn which="always" if="always"/>
				<do func="mov">
					<inputs>
						<in name="ReadData2"/>
						<in name="Extended"/>
						<in name="MOVOP"/>
					</inputs>
					<outputs>
						<out name="MOVResult"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>Memory</name>
		<specialComponent comp="MainMemory"/>
		<description>Data Memory</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ReadData" bits="64" optional="true" optionalDependsOn="MEMREAD"  optionalComp="Control" optionalIf="0" alternativeStr="true">
				<to name="ReadData" comp="MuxMEMTOREG"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="Address" bits="64"/>
			<input name="WriteData" bits="64"/>
			<input name="MEMREAD" bits="1"/>
			<input name="MEMWRITE" bits="1"/>
			<input name="MEMSIZE" bits="2"/>
			<input name="SIGNLOAD" bits="1"/>
		</inputBuses>
		<operations>
			<op name="readmem">
				<dependsOn which="MEMREAD" if="1"/>
				<do func="readmem">
					<inputs>
						<in name="Address"/>
						<in name="MEMSIZE"/>
						<in name="SIGNLOAD"/>
					</inputs>
					<outputs>
						<out name="ReadData"/>
					</outputs>
				</do>
			</op>
			<op name="writemem">
				<dependsOn which="MEMWRITE" if="1"/>
				<do func="writemem">
					<inputs>
						<in name="Address"/>
						<in name="WriteData"/>
						<in name="MEMSIZE"/>
					</inputs>
				</do>
			</op>
			<op name="donothing">
				<dependsOn which="always" if="always"/>
				<do func="donothing">
				</do>
			</op>
		</operations>
	</Component>

	<!-- Start MuxREG1LOC -->
	<Component>
		<name>XZR</name>
		<description>Output index of XZR</description>
		<hidden>true</hidden>
		<outputBuses>
			<output name="XZR" bits="5" alternativeStr="true">
				<to name="XZR" comp="MuxREG1LOC"/>
			</output>
		</outputBuses>
		<operations>
			<op name="XZR">
				<dependsOn which="always" if="always"/>
				<do func="out" out="11111">
					<outputs>
						<out name="XZR"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>MuxREG1LOC</name>
		<description>Multiplexor XZR or Rn</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ReadReg1" bits="5">
				<to name="ReadReg1" comp="Registers"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="REG1LOC" bits="1"/>
			<input name="XZR" bits="5"/>
			<input name="Rn" bits="5"/>
		</inputBuses>
		<operations>
			<op name="XZR">
				<dependsOn which="REG1LOC" if="1"/>
				<do func="mux">
					<inputs>
						<in name="XZR"/>
					</inputs>
					<outputs>
						<out name="ReadReg1"/>
					</outputs>
				</do>
			</op>
			<op name="Rn">
				<dependsOn which="REG1LOC" if="0"/>
				<do func="mux">
					<inputs>
						<in name="Rn"/>
					</inputs>
					<outputs>
						<out name="ReadReg1"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- End MuxREG1LOC -->

	<!-- Start MuxREG2LOC-->
		<Component>
		<name>MuxREG2LOC</name>
		<description>Multiplexor Rd or Rm</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ReadReg2" bits="5">
				<to name="ReadReg2" comp="Registers"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="REG2LOC" bits="1"/>
			<input name="Rd" bits="5"/>
			<input name="Rm" bits="5"/>
		</inputBuses>
		<operations>
			<op name="Rd">
				<dependsOn which="REG2LOC" if="1"/>
				<do func="mux">
					<inputs>
						<in name="Rd"/>
					</inputs>
					<outputs>
						<out name="ReadReg2"/>
					</outputs>
				</do>
			</op>
			<op name="Rm">
				<dependsOn which="REG2LOC" if="0"/>
				<do func="mux">
					<inputs>
						<in name="Rm"/>
					</inputs>
					<outputs>
						<out name="ReadReg2"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- End MuxREG2LOC-->

	<!-- Start MuxPCTOREG-->
	<Component>
		<name>XLR</name>
		<description>Output index of XLR</description>
		<hidden>true</hidden>
		<outputBuses>
			<output name="XLR" bits="5" alternativeStr="true">
				<to name="XLR" comp="MuxPCTOREG1"/>
			</output>
		</outputBuses>
		<operations>
			<op name="XLR">
				<dependsOn which="always" if="always"/>
				<do func="out" out="11110">
					<outputs>
						<out name="XLR"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>MuxPCTOREG1</name>
		<description>Multiplexor XLR or Rd</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="WriteReg" bits="5">
				<to name="WriteReg" comp="Registers"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="PCTOREG" bits="1"/>
			<input name="XLR" bits="5"/>
			<input name="Rd" bits="5"/>
		</inputBuses>
		<operations>
			<op name="XLR">
				<dependsOn which="PCTOREG" if="1"/>
				<do func="mux">
					<inputs>
						<in name="XLR"/>
					</inputs>
					<outputs>
						<out name="WriteReg"/>
					</outputs>
				</do>
			</op>
			<op name="Rd">
				<dependsOn which="PCTOREG" if="0"/>
				<do func="mux">
					<inputs>
						<in name="Rd"/>
					</inputs>
					<outputs>
						<out name="WriteReg"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- End MuxPCTOREG-->

	<!-- Start MuxALU1SRC-->
	<Component>
		<name>MuxALU1SRC</name>
		<description>Multiplexor for ALU input 1, selects PC or ReadData1</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ALUInp1" bits="64" alternativeStr="true">
				<to name="ALUInp1" comp="ALU"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="ALU1SRC" bits="1"/>
			<input name="PC" bits="64"/>
			<input name="ReadData1" bits="64"/>
		</inputBuses>
		<operations>
			<op name="SelectReadData1">
				<dependsOn which="ALU1SRC" if="0"/>
				<do func="mux">
					<inputs>
						<in name="ReadData1"/>
					</inputs>
					<outputs>
						<out name="ALUInp1"/>
					</outputs>
				</do>
			</op>
			<op name="SelectPC">
				<dependsOn which="ALU1SRC" if="1"/>
				<do func="mux">
					<inputs>
						<in name="PC"/>
					</inputs>
					<outputs>
						<out name="ALUInp1"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- End MuxALU1SRC-->

	<!-- Start MuxALU2SRC -->
	<Component>
		<name>MuxALU2SRC</name>
		<description>Multiplexor for ALU input 2, selects SignExtended or ReadData2</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ALUInp2" bits="64" alternativeStr="true">
				<to name="ALUInp2" comp="ALU"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="ALU2SRC" bits="1"/>
			<input name="SignExtended" bits="64"/>
			<input name="ReadData2" bits="64"/>
		</inputBuses>
		<operations>
			<op name="SelectReadData2">
				<dependsOn which="ALU2SRC" if="0"/>
				<do func="mux">
					<inputs>
						<in name="ReadData2"/>
					</inputs>
					<outputs>
						<out name="ALUInp2"/>
					</outputs>
				</do>
			</op>
			<op name="SelectSignExtended">
				<dependsOn which="ALU2SRC" if="1"/>
				<do func="mux">
					<inputs>
						<in name="SignExtended"/>
					</inputs>
					<outputs>
						<out name="ALUInp2"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- End MuxALU2SRC-->

	<!-- Start MuxUSEMOV-->
	<Component>
		<name>MuxUSEMOV</name>
		<description>Multiplexor selects MOVResult or ALUResult</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Result" bits="64" alternativeStr="true">
				<to name="Result" comp="MuxMEMTOREG"/>
				<to name="Result" comp="MuxBranch"/>
				<to name="Address" comp="Memory"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="USEMOV" bits="1"/>
			<input name="MOVResult" bits="64"/>
			<input name="ALUResult" bits="64"/>
		</inputBuses>
		<operations>
			<op name="SelectALUResult">
				<dependsOn which="USEMOV" if="0"/>
				<do func="mux">
					<inputs>
						<in name="ALUResult"/>
					</inputs>
					<outputs>
						<out name="Result"/>
					</outputs>
				</do>
			</op>
			<op name="SelectMOVResult">
				<dependsOn which="USEMOV" if="1"/>
				<do func="mux">
					<inputs>
						<in name="MOVResult"/>
					</inputs>
					<outputs>
						<out name="Result"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- End MuxUSEMOV-->

	<!-- Start MuxMEMTOREG -->
	<Component>
		<name>MuxMEMTOREG</name>
		<description>Multiplexor selects ReadData or Result</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="MEMTOREGResult" bits="64" alternativeStr="true">
				<to name="MEMTOREGResult" comp="MuxPCTOREG2"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="MEMTOREG" bits="1"/>
			<input name="Result" bits="64"/>
			<input name="ReadData" bits="64"/>
		</inputBuses>
		<operations>
			<op name="SelectResult">
				<dependsOn which="MEMTOREG" if="0"/>
				<do func="mux">
					<inputs>
						<in name="Result"/>
					</inputs>
					<outputs>
						<out name="MEMTOREGResult"/>
					</outputs>
				</do>
			</op>
			<op name="SelectReadData">
				<dependsOn which="MEMTOREG" if="1"/>
				<do func="mux">
					<inputs>
						<in name="ReadData"/>
					</inputs>
					<outputs>
						<out name="MEMTOREGResult"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- End MuxMEMTOREG-->

	<!-- Start MuxPCTOREG -->
	<Component>
		<name>MuxPCTOREG2</name>
		<description>Multiplexor selects PC or MEMTOREGResult</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="WriteData" bits="64" optional="true" finalBus="true">
				<to name="WriteData" comp="Registers"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="PCTOREG" bits="1"/>
			<input name="MEMTOREGResult" bits="64"/>
			<input name="PC" bits="64"/>
		</inputBuses>
		<operations>
			<op name="SelectMEMTOREGResult">
				<dependsOn which="PCTOREG" if="0"/>
				<do func="mux">
					<inputs>
						<in name="MEMTOREGResult"/>
					</inputs>
					<outputs>
						<out name="WriteData"/>
					</outputs>
				</do>
			</op>
			<op name="SelectPC">
				<dependsOn which="PCTOREG" if="1"/>
				<do func="mux">
					<inputs>
						<in name="PC"/>
					</inputs>
					<outputs>
						<out name="WriteData"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- End MuxPCTOREG -->

	<!-- Start MuxBranch-->
	<Component>
		<name>PCIncrement</name>
		<description>Incrementing PC by 4</description>
		<hidden>false</hidden>
		<inputBuses>
			<input name="PC" bits="64"/>
		</inputBuses>
		<outputBuses>
			<output name="PCPlus4" bits="64" alternativeStr="true">
				<to name="PCPlus4" comp="MuxBranch"/>
			</output>
		</outputBuses>
		<operations>
			<op name="PCPlus4">
				<dependsOn which="always" if="always"/>
				<do func="incrementPC">
					<inputs>
						<in name="PC"/>
					</inputs>
					<outputs>
						<out name="PCPlus4"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>MuxBranch</name>
		<description>Multiplexor selects next PC value based on Branch signal</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="newPC" bits="64">
				<to name="newPC" comp="PC"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="Branch" bits="1"/>
			<input name="Result" bits="64"/>
			<input name="PCPlus4" bits="64"/>
		</inputBuses>
		<operations>
			<op name="SelectPCPlus4">
				<dependsOn which="Branch" if="0"/>
				<do func="mux">
					<inputs>
						<in name="PCPlus4"/>
					</inputs>
					<outputs>
						<out name="newPC"/>
					</outputs>
				</do>
			</op>
			<op name="SelectBranchTarget">
				<dependsOn which="Branch" if="1"/>
				<do func="mux">
					<inputs>
						<in name="Result"/>
					</inputs>
					<outputs>
						<out name="newPC"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<!-- End MuxBranch-->
</Simulator>
