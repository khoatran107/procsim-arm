<?xml version="1.0" encoding="UTF-8"?>
<Simulator>
	<simname>LEGv8 Single-Cycle - R-Format, LDUR, STUR, CBZ, B</simname>
	<SuportedISA>R-Format, LDUR, STUR, CBZ, B</SuportedISA>
	<Options resetEveryRound="true"/>

	<Component>
		<name>PC</name>
		<description>Progam Counter</description>
		<specialComponent comp="StartComp"/>
		<hidden>false</hidden>
		<outputBuses>
			<output name="PC" bits="64" alternativeStr="true">
				<to name="PC" comp="ALUIncr"/>
				<to name="PCAddress" comp="InstrMemory"/>
				<to name="PC+4" comp="ALUBranch" />
			</output>
		</outputBuses>
		<inputBuses>
			<input name="newPC" bits="64"/>
		</inputBuses>
		<operations>
			<op name="ReadReg1">
				<dependsOn which="always" if="always"/>
				<do func="mux">
					<inputs>
						<in name="newPC"/>
					</inputs>
					<outputs>
						<out name="PC"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>InstrMemory</name>
		<specialComponent comp="InstructionMemory"/>
		<description>Intruction Memory</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Intruction" bits="32" alternativeStr="true">
				<to name="Instr" comp="Spliter"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="PCAddress" bits="64"/>
		</inputBuses>
		<operations>
			<op name="ReadAddress">
				<dependsOn which="always" if="always"/>
				<do func="getInstruction">
					<inputs>
						<in name="PCAddress"/>
					</inputs>
					<outputs>
						<out name="Intruction"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>


	<Component>
		<name>Spliter</name>
		<description>Instruction Spliter</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Opcode" bits="11">
				<to name="InControl" comp="Control"/>
			</output>
			<output name="Rs" bits="5">
				<to name="ReadReg1" comp="Registers"/>
			</output>
			<output name="Rt" bits="5">
				<to name="ReadReg2_1" comp="Mux1"/>
			</output>
			<output name="Rd" bits="5">
				<to name="ReadReg2_2" comp="Mux1"/>
				<to name="WriteReg" comp="Registers"/>
			</output>
			<output name="InstructionToSExtend" bits="32">
				<to name="InstructionToSExtend" comp="SExtend"/>
			</output>
			<output name="OpcodeALUControl" bits="11">
				<to name="Opcode" comp="ALUControl"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="Instr" bits="32"/>
		</inputBuses>
		<operations>
			<op name="Opcode31-21">
				<dependsOn which="always" if="always"/>
				<do func="split" out="31-21">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Opcode"/>
					</outputs>
				</do>
			</op>
			<op name="Rs09-05">
				<dependsOn which="always" if="always"/>
				<do func="split" out="9-5">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Rs"/>
					</outputs>
				</do>
			</op>
			<op name="Rt20-16">
				<dependsOn which="always" if="always"/>
				<do func="split" out="20-16">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Rt"/>
					</outputs>
				</do>
			</op>
			<op name="Rd04-00">
				<dependsOn which="always" if="always"/>
				<do func="split" out="4-0">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="Rd"/>
					</outputs>
				</do>
			</op>
			<op name="Opcode31-0">
				<dependsOn which="always" if="always"/>
				<do func="split" out="31-0">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="InstructionToSExtend"/>
					</outputs>
				</do>
			</op>
			<op name="Opcode31-21">
				<dependsOn which="always" if="always"/>
				<do func="split" out="31-21">
					<inputs>
						<in name="Instr"/>
					</inputs>
					<outputs>
						<out name="OpcodeALUControl"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	

	<Component>
		<name>Control</name>
		<description>Control Unit</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Reg2Loc" bits="1">
				<to name="Reg2Loc" comp="Mux1"/>
			</output>
			<output name="UncondBranch" bits="1">
				<to name="UncondBranch" comp="OrBranch"/>
			</output>
			<output name="Branch" bits="1">
				<to name="BranchIn" comp="ZeroAnd"/>
			</output>
			<output name="MemRead" bits="1">
				<to name="MemRead" comp="Memory"/>
			</output>
			<output name="MemToReg" bits="1">
				<to name="MemOrResultToReg" comp="Mux3"/>
			</output>
			<output name="MemWrite" bits="1">
				<to name="MemWrite" comp="Memory"/>
			</output>
			<output name="ALUSrc" bits="1">
				<to name="ALUSrc" comp="Mux4"/>
			</output>
			<output name="ALUOp" bits="2">
				<to name="ALUOp" comp="ALUControl"/>
			</output>
			<output name="RegWrite" bits="1">
				<to name="RegWrite" comp="Registers"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="InControl" bits="11"/>
		</inputBuses>
		<operations>
			<op name="control-r-format">
				<dependsOn which="InControl" if="1xx0101x000"/>
				<do func="bitout" out="0001000010">
					<outputs>
						<out name="Reg2Loc"/>
						<out name="ALUSrc"/>
						<out name="MemToReg"/>
						<out name="RegWrite"/>
						<out name="MemRead"/>
						<out name="MemWrite"/>
						<out name="Branch"/>
						<out name="UncondBranch"/>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-ldur">
				<dependsOn which="InControl" if="11111000010"/>
				<do func="bitout" out="0111100000">
					<outputs>
						<out name="Reg2Loc"/>
						<out name="ALUSrc"/>
						<out name="MemToReg"/>
						<out name="RegWrite"/>
						<out name="MemRead"/>
						<out name="MemWrite"/>
						<out name="Branch"/>
						<out name="UncondBranch"/>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-stur">
				<dependsOn which="InControl" if="11111000000"/>
				<do func="bitout" out="1100010000">
					<outputs>
						<out name="Reg2Loc"/>
						<out name="ALUSrc"/>
						<out name="MemToReg"/>
						<out name="RegWrite"/>
						<out name="MemRead"/>
						<out name="MemWrite"/>
						<out name="Branch"/>
						<out name="UncondBranch"/>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-cbz">
				<dependsOn which="InControl" if="10110100xxx"/>
				<do func="bitout" out="1000001001">
					<outputs>
						<out name="Reg2Loc"/>
						<out name="ALUSrc"/>
						<out name="MemToReg"/>
						<out name="RegWrite"/>
						<out name="MemRead"/>
						<out name="MemWrite"/>
						<out name="Branch"/>
						<out name="UncondBranch"/>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-b">
				<dependsOn which="InControl" if="000101xxxxx"/>
				<do func="bitout" out="0000000100">
					<outputs>
						<out name="Reg2Loc"/>
						<out name="ALUSrc"/>
						<out name="MemToReg"/>
						<out name="RegWrite"/>
						<out name="MemRead"/>
						<out name="MemWrite"/>
						<out name="Branch"/>
						<out name="UncondBranch"/>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	
	<Component>
		<name>Mux1</name>
		<description>Multiplexor Reg Dest</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ReadReg2" bits="5">
				<to name="ReadReg2" comp="Registers"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="Reg2Loc" bits="1"/>
			<input name="ReadReg2_1" bits="5"/>
			<input name="ReadReg2_2" bits="5"/>
		</inputBuses>
		<operations>
			<op name="ReadReg2_1">
				<dependsOn which="Reg2Loc" if="0"/>
				<do func="mux">
					<inputs>
						<in name="ReadReg2_1"/>
					</inputs>
					<outputs>
						<out name="ReadReg2"/>
					</outputs>
				</do>
			</op>
			<op name="ReadReg2_2">
				<dependsOn which="Reg2Loc" if="1"/>
				<do func="mux">
					<inputs>
						<in name="ReadReg2_2"/>
					</inputs>
					<outputs>
						<out name="ReadReg2"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	
	<Component>
		<name>Registers</name>
		<specialComponent comp="Registers"/>
		<description>Set of Registers</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ReadData" bits="64" alternativeStr="true">
				<to name="ALUInp1" comp="Main ALU"/>
			</output>
			<output name="ReadData2" bits="64" alternativeStr="true">
				<to name="in0ReadData" comp="Mux4"/>
				<to name="Write Data" comp="Memory"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="ReadReg1" bits="5"/>
			<input name="ReadReg2" bits="5"/>
			<input name="WriteReg" bits="5"/>
			<input name="WriteData" bits="64"/>
			<input name="RegWrite" bits="1"/>
		</inputBuses>
		<operations>
			<op name="ReadReg1">
				<dependsOn which="always" if="always"/>
				<do func="readreg">
					<inputs>
						<in name="ReadReg1"/>
					</inputs>
					<outputs>
						<out name="ReadData"/>
					</outputs>
				</do>
			</op>
			<op name="ReadReg2">
				<dependsOn which="always" if="always"/>
				<do func="readreg">
					<inputs>
						<in name="ReadReg2"/>
					</inputs>
					<outputs>
						<out name="ReadData2"/>
					</outputs>
				</do>
			</op>
			<op name="WriteData">
				<dependsOn which="RegWrite" if="1"/>
				<do func="writereg">
					<inputs>
						<in name="WriteReg"/>
						<in name="WriteData"/>
					</inputs>
					<outputs>
						<out name="ReadData2"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<!-- Sign extend module begin -->
	
	<Component>
		<name>SExtend</name>
		<description>Split Data for Sign Extend</description>
		<hidden>false</hidden>
		<outputBuses>

			<!-- DATA INPUT FOR SIGN EXTEND SUB-MODULES -->
			<output name="BSignExtendRawInput" bits="26">
				<to name="input" comp="BSignExtend"/>
			</output>
			<output name="CBZSignExtendRawInput" bits="19">
				<to name="input" comp="CBZSignExtend"/>
			</output>
			<output name="LoadStoreSignExtendRawInput" bits="9">
				<to name="input" comp="LoadStoreSignExtend"/>
			</output>

			<!-- SELECT INPUT FOR SIGN EXTEND MUXES -->
			<output name="B_CBZ_Select" bits="1">
				<to name="selectInput" comp="B_CBZ_Mux"/>
			</output>
			<output name="Branch_LoadStore_Select" bits="1">
				<to name="selectInput" comp="Branch_LoadStore_Mux"/>
			</output>

		</outputBuses>
		<inputBuses>
			<input name="InstructionToSExtend" bits="32"/>
		</inputBuses>
		<operations>
			<op name="SplitBSignExtend">
				<dependsOn which="always" if="always"/>
				<do func="split" out="25-0">
					<inputs>
						<in name="InstructionToSExtend"/>
					</inputs>
					<outputs>
						<out name="BSignExtendRawInput"/>
					</outputs>
				</do>
			</op>
			<op name="SplitCBZSignExtend">
				<dependsOn which="always" if="always"/>
				<do func="split" out="23-5">
					<inputs>
						<in name="InstructionToSExtend"/>
					</inputs>
					<outputs>
						<out name="CBZSignExtendRawInput"/>
					</outputs>
				</do>
			</op>
			<op name="SplitLoadStoreSignExtend">
				<dependsOn which="always" if="always"/>
				<do func="split" out="20-12">
					<inputs>
						<in name="InstructionToSExtend"/>
					</inputs>
					<outputs>
						<out name="LoadStoreSignExtendRawInput"/>
					</outputs>
				</do>
			</op>

			<!-- select input -->
			<op name="Split_B_CBZ_Select">
				<dependsOn which="always" if="always"/>
				<do func="split" out="31-31">
					<inputs>
						<in name="InstructionToSExtend"/>
					</inputs>
					<outputs>
						<out name="B_CBZ_Select"/>
					</outputs>
				</do>
			</op>

			<op name="Split_Branch_LoadStore_Select">
				<dependsOn which="always" if="always"/>
				<do func="split" out="26-26">
					<inputs>
						<in name="InstructionToSExtend"/>
					</inputs>
					<outputs>
						<out name="Branch_LoadStore_Select"/>
					</outputs>
				</do>
			</op>

		</operations>
	</Component>


	<!-- SIGN EXTEND SUB-MODULES -->
	<Component>
		<name>BSignExtend</name>
		<description>BSignExtend</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="BSignExtended" bits="64" alternativeStr="true">
				<to name="input0" comp="B_CBZ_Mux"/>	
			</output>
		</outputBuses>
		<inputBuses>
			<input name="input" bits="26"/>
		</inputBuses>
		<operations>
			<op name="SignExtend">
				<dependsOn which="always" if="always"/>
				<do func="signextend" out="64">
					<inputs>
						<in name="input"/>
					</inputs>
					<outputs>
						<out name="BSignExtended"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>CBZSignExtend</name>
		<description>CBZSignExtend</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="CBZSignExtended" bits="64" alternativeStr="true">
				<to name="input1" comp="B_CBZ_Mux"/>	
			</output>
		</outputBuses>
		<inputBuses>
			<input name="input" bits="19"/>
		</inputBuses>
		<operations>
			<op name="SignExtend">
				<dependsOn which="always" if="always"/>
				<do func="signextend" out="64">
					<inputs>
						<in name="input"/>
					</inputs>
					<outputs>
						<out name="CBZSignExtended"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>LoadStoreSignExtend</name>
		<description>LoadStoreSignExtend</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="LoadStoreSignExtendeded" bits="64" alternativeStr="true">
				<to name="input0" comp="Branch_LoadStore_Mux"/>	
			</output>
		</outputBuses>
		<inputBuses>
			<input name="input" bits="9"/>
		</inputBuses>
		<operations>
			<op name="SignExtend">
				<dependsOn which="always" if="always"/>
				<do func="signextend" out="64">
					<inputs>
						<in name="input"/>
					</inputs>
					<outputs>
						<out name="LoadStoreSignExtendeded"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	<!-- Sign Extend MUX -->

	<Component>
		<name>B_CBZ_Mux</name>
		<description>B_CBZ_Mux</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="output" bits="64" alternativeStr="true">
				<to name="input1" comp="Branch_LoadStore_Mux"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="selectInput" bits="1"/>
			<input name="input0" bits="64"/>
			<input name="input1" bits="64"/>
		</inputBuses>
		<operations>
			<op name="input0">
				<dependsOn which="selectInput" if="0"/>
				<do func="mux">
					<inputs>
						<in name="input0"/>
					</inputs>
					<outputs>
						<out name="output"/>
					</outputs>
				</do>
			</op>
			<op name="input1">
				<dependsOn which="selectInput" if="1"/>
				<do func="mux">
					<inputs>
						<in name="input1"/>
					</inputs>
					<outputs>
						<out name="output"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>Branch_LoadStore_Mux</name>
		<description>Branch_LoadStore_Mux</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="output" bits="64" alternativeStr="true">
				<to name="in1Const" comp="Mux4"/>
				<to name="Addr" comp="ShiftLeft"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="selectInput" bits="1"/>
			<input name="input0" bits="64"/>
			<input name="input1" bits="64"/>
		</inputBuses>
		<operations>
			<op name="input0">
				<dependsOn which="selectInput" if="0"/>
				<do func="mux">
					<inputs>
						<in name="input0"/>
					</inputs>
					<outputs>
						<out name="output"/>
					</outputs>
				</do>
			</op>
			<op name="input1">
				<dependsOn which="selectInput" if="1"/>
				<do func="mux">
					<inputs>
						<in name="input1"/>
					</inputs>
					<outputs>
						<out name="output"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<!-- Sign extend module end -->

	<Component>
		<name>ALUControl</name>
		<description>ALU Control Unit</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ALUOp" bits="4">
				<to name="ALUOp" comp="Main ALU"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="ALUOp" bits="2"/>
			<input name="Opcode" bits="11"/>
		</inputBuses>
		<operations>
			<op name="control-ldur-stur">
				<dependsOn which="ALUOp" if="00"/>
				<dependsOn which="Opcode" if="xxxxxxxxxxx"/>
				<do func="out" out="0010">
					<outputs>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-cbz">
				<dependsOn which="ALUOp" if="01"/>
				<dependsOn which="Opcode" if="xxxxxxxxxxx"/>
				<do func="out" out="0111">
					<outputs>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-r-add">
				<dependsOn which="ALUOp" if="10"/>
				<dependsOn which="Opcode" if="10001011000"/>
				<do func="out" out="0010">
					<outputs>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-r-subtract">
				<dependsOn which="ALUOp" if="10"/>
				<dependsOn which="Opcode" if="11001011000"/>
				<do func="out" out="0110">
					<outputs>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-r-and">
				<dependsOn which="ALUOp" if="10"/>
				<dependsOn which="Opcode" if="10001010000"/>
				<do func="out" out="0000">
					<outputs>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
			<op name="control-r-or">
				<dependsOn which="ALUOp" if="10"/>
				<dependsOn which="Opcode" if="10101010000"/>
				<do func="out" out="0001">
					<outputs>
						<out name="ALUOp"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>Main ALU</name>
		<description>Arithmetic Logic Unit</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="result" bits="64" alternativeStr="true">
				<to name="Address" comp="Memory"/>
				<to name="In0Result" comp="Mux3"/>
			</output>
			<output name="zero" bits="1">
				<to name="ANDZeroIn" comp="ZeroAnd"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="ALUOp" bits="4"/>
			<input name="ALUInp1" bits="64"/>
			<input name="ALUInp2" bits="64"/>
		</inputBuses>
		<operations>
			<op name="and">
				<dependsOn which="ALUOp" if="0000"/>
				<do func="and">
					<inputs>
						<in name="ALUInp1"/>
						<in name="ALUInp2"/>
					</inputs>
					<outputs>
						<out name="result"/>
					</outputs>
				</do>
			</op>
			<op name="or">
				<dependsOn which="ALUOp" if="0001"/>
				<do func="or">
					<inputs>
						<in name="ALUInp1"/>
						<in name="ALUInp2"/>
					</inputs>
					<outputs>
						<out name="result"/>
					</outputs>
				</do>
			</op>
			<op name="add">
				<dependsOn which="ALUOp" if="0010"/>
				<do func="add">
					<inputs>
						<in name="ALUInp1"/>
						<in name="ALUInp2"/>
					</inputs>
					<outputs>
						<out name="result"/>
					</outputs>
				</do>
			</op>
			<op name="sub">
				<dependsOn which="ALUOp" if="0110"/>
				<do func="sub">
					<inputs>
						<in name="ALUInp1"/>
						<in name="ALUInp2"/>
					</inputs>
					<outputs>
						<out name="result"/>
					</outputs>
				</do>
			</op>

			<op name="pass-input-b">
				<dependsOn which="ALUOp" if="0111"/>
				<do func="mux">
					<inputs>
						<in name="ALUInp2"/>
					</inputs>
					<outputs>
						<out name="result"/>
					</outputs>
				</do>
			</op>
			<op name="pass-input-b-zero">
				<dependsOn which="ALUOp" if="0111"/>
				<do func="zero">
					<inputs>
						<in name="ALUInp2"/>
					</inputs>
					<outputs>
						<out name="zero"/>
					</outputs>
				</do>
			</op>
			
		</operations>
	</Component>

	<Component>
		<name>ZeroAnd</name>
		<description>AND - for Zero Branch</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="AND1Out" bits="1">
				<to name="ZeroBranch" comp="OrBranch"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="BranchIn" bits="1"/>
			<input name="ANDZeroIn" bits="1"/>
		</inputBuses>
		<operations>
			<op name="and">
				<dependsOn which="always" if="always"/>
				<do func="and">
					<inputs>
						<in name="BranchIn"/>
						<in name="ANDZeroIn"/>
					</inputs>
					<outputs>
						<out name="AND1Out"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>OrBranch</name>
		<description>Or unconditional branch - zero branch</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="PCSrc" bits="1">
				<to name="PCSrc" comp="Mux2"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="UncondBranch" bits="1"/>
			<input name="ZeroBranch" bits="1"/>
		</inputBuses>
		<operations>
			<op name="or">
				<dependsOn which="always" if="always"/>
				<do func="or">
					<inputs>
						<in name="UncondBranch"/>
						<in name="ZeroBranch"/>
					</inputs>
					<outputs>
						<out name="PCSrc"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>Memory</name>
		<specialComponent comp="MainMemory"/>
		<description>Data Memory</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ReadData" bits="64" optional="true" optionalDependsOn="MemRead"  optionalComp="Control" optionalIf="0" alternativeStr="true">
				<to name="In1Data" comp="Mux3"/>
			</output>
		</outputBuses>
		<inputBuses>f
			<input name="Address" bits="64"/>
			<input name="Write Data" bits="64"/>
			<input name="MemWrite" bits="1"/>
			<input name="MemRead" bits="1"/>
		</inputBuses>
		<operations>
			<op name="readmem">
				<dependsOn which="MemRead" if="1"/>
				<do func="readmem">
					<inputs>
						<in name="Address"/>
					</inputs>
					<outputs>
						<out name="ReadData"/>
					</outputs>
				</do>
			</op>
			<op name="writemem">
				<dependsOn which="MemWrite" if="1"/>
				<do func="writemem">
					<inputs>
						<in name="Address"/>
						<in name="Write Data"/>
					</inputs>
				</do>
			</op>
			<op name="donothing">
				<dependsOn which="always" if="always"/>
				<do func="donothing">
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>Mux3</name>
		<description>Multiplexor ALU result or data</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Data" bits="64"  optional="true" finalBus="true" alternativeStr="true">
				<to name="WriteData" comp="Registers"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="In1Data" bits="64"/>
			<input name="In0Result" bits="64"/>
			<input name="MemOrResultToReg" bits="1"/>
		</inputBuses>
		<operations>
			<op name="MemToReg">
				<dependsOn which="MemOrResultToReg" if="1"/>
				<do func="mux">
					<inputs>
						<in name="In1Data"/>
					</inputs>
					<outputs>
						<out name="Data"/>
					</outputs>
				</do>
			</op>
			<op name="resulttoreg">
				<dependsOn which="MemOrResultToReg" if="0"/>
				<do func="mux">
					<inputs>
						<in name="In0Result"/>
					</inputs>
					<outputs>
						<out name="Data"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	
	<Component>
		<name>ALUBranch</name>
		<description>Calc Branch Target ALU</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="result" bits="64" alternativeStr="true">
				<to name="in1ALUBranch" comp="Mux2"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="PC+4" bits="64"/>
			<input name="AddressField" bits="64"/>
		</inputBuses>
		<operations>
			<op name="add">
				<do func="add">
					<inputs>
						<in name="PC+4"/>
						<in name="AddressField"/>
					</inputs>
					<outputs>
						<out name="result"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	<Component>
		<name>Mux2</name>
		<description>Multiplexor branch or +4</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="newPC" bits="64" alternativeStr="true">
				<to name="newPC" comp="PC"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="PCSrc" bits="1"/>
			<input name="in1ALUBranch" bits="64"/>
			<input name="in0PCIncrem" bits="64"/>
		</inputBuses>
		<operations>
			<op name="branchtoPC">
				<dependsOn which="PCSrc" if="1"/>
				<do func="mux">
					<inputs>
						<in name="in1ALUBranch"/>
					</inputs>
					<outputs>
						<out name="newPC"/>
					</outputs>
				</do>
			</op>
			<op name="IncremPC">
				<dependsOn which="PCSrc" if="0"/>
				<do func="mux">
					<inputs>
						<in name="in0PCIncrem"/>
					</inputs>
					<outputs>
						<out name="newPC"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	
	
	<Component>
		<name>Mux4</name>
		<description>Multiplexor ReadData or Const</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="ALUInp2" bits="64" alternativeStr="true">
				<to name="ALUInp2" comp="Main ALU"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="ALUSrc" bits="1"/>
			<input name="in0ReadData" bits="64"/>
			<input name="in1Const" bits="64"/>
		</inputBuses>
		<operations>
			<op name="ReadData">
				<dependsOn which="ALUSrc" if="0"/>
				<do func="mux">
					<inputs>
						<in name="in0ReadData"/>
					</inputs>
					<outputs>
						<out name="ALUInp2"/>
					</outputs>
				</do>
			</op>
			<op name="Const">
				<dependsOn which="ALUSrc" if="1"/>
				<do func="mux">
					<inputs>
						<in name="in1Const"/>
					</inputs>
					<outputs>
						<out name="ALUInp2"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

	
	<Component>
		<name>ShiftLeft</name>
		<description>Shift Left 2 (= inp * 4)</description>
		<hidden>false</hidden>
		<outputBuses>
			<output name="Addr*4" bits="64" alternativeStr="true">
				<to name="AddressField" comp="ALUBranch"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="Addr" bits="64"/>
		</inputBuses>
		<operations>
			<op name="ShiftLeft2">
				<dependsOn which="always" if="always"/>
				<do func="shiftleft" out="2">
					<inputs>
						<in name="Addr"/>
					</inputs>
					<outputs>
						<out name="Addr*4"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
		
	<Component>
		<name>Out4</name>
		<description>For incrementing PC by 4</description>
		<hidden>true</hidden>
		<outputBuses>
			<output name="out4" bits="64" alternativeStr="true">
				<to name="Increm4" comp="ALUIncr"/>
			</output>
		</outputBuses>
		<operations>
			<op name="out4">
				<dependsOn which="always" if="always"/>
				<do func="out" out="100">
					<outputs>
						<out name="out4"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>
	
	<Component>
		<name>ALUIncr</name>
		<description>Increment PC ALU</description>
		<outputBuses>
			<output name="PC+4" bits="64" alternativeStr="true">
				<to name="in0PCIncrem" comp="Mux2"/>
			</output>
		</outputBuses>
		<inputBuses>
			<input name="Increm4" bits="64"/>
			<input name="PC" bits="64"/>			
		</inputBuses>
		<operations>
			<op name="increm4">
				<dependsOn which="always" if="always"/>
				<do func="add">
					<inputs>
						<in name="Increm4"/>
						<in name="PC"/>
					</inputs>
					<outputs>
						<out name="PC+4"/>
					</outputs>
				</do>
			</op>
		</operations>
	</Component>

</Simulator>
